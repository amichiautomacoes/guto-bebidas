# Use o pooler do Supabase quando a hospedagem exigir conexões IPv4.
SUPABASE_DATABASE_URL=postgresql://usuario:senha@host:5432/postgres
SUPABASE_SCHEMA=guto-bebidas
# Obrigatório para concluir pedidos reais. Use HTTPS.
SDR_WEBHOOK_URL=
# Se configurado, autentica e assina os envios ao SDR.
SDR_WEBHOOK_SECRET=
